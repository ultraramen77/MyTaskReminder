<html>
<head>
    <meta charset="UTF-8">    <%# code below is to set up the head section of the HTML document, including meta tags for character encoding and viewport settings, as well as links to Bootstrap CSS and JS files for styling and responsiveness. %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>The Trusty Task Reminder</title>
</head>
<body style="background-image: url('/IMG_0136-1280x920.jpeg');">
    <%- include ('partials/navbar') %>    <%#To include the navigation bar in the home page %>
    <h2><span style="color: indigo;">Welcome Back to your very own TASK REMINDER, whose here to not let your forgetfulness forget</span></h2>
    <br>
    <h5><span style="color: navy;">I am ready to not make you forget</span></h5>
    
    <hr class="my-4">
    <h3 class="mb-3 text-dark fw-bold">Task Board:</h3>
        
    <div class="row g-3">               <%# Create a container to hold the task board, where all the tasks added by the user will be displayed. %>
        <% if (tasksList.length === 0) { %>
                <div class="col-12">
                    <div class="alert alert-info">No tasks registered yet. Click 'Add A Task' to add one!</div>
                </div>
            <% } %>
        
            <%# Dynamic Loop Strategy: Cycles through every object stored inside your tasksList array %>
            <% for(let i = 0; i < tasksList.length ; i++) { %>      
                
                <%# Each task generates inside a structural column framework taking up 4 out of 12 slots (3 per line on desktops) %>
                <div class="col-12 col-md-6 col-lg-4">
                    
                    <%# The UI Card Box Structure mapping your pencil blueprint layout design %>
                    <div class="card h-100 shadow-sm border-dark">
                        <div class="card-body d-flex flex-column justify-content-between bg-light">
                            <div>
                                <%# Displays the custom Task Name Title at the header section %>
                                <h5 class="card-title text-primary fw-bold text-wrap"><%= tasksList[i].name %></h5>
                                
                                <%# Renders the matching specific Priority Level indicator underneath %>
                                <p class="card-text mb-1">Priority: 
                                    <span class="badge" <%= tasksList[i].priority === 'IMPORTANT!' ? 'bg-danger' : 'bg-warning text-dark' %>">
                                        <%= tasksList[i].priority %>
                                    </span>
                                </p>
                                
                                <%# Maps out the target deadline timestamp exactly as sketched %>
                                <p class="card-text text-muted small">Finish by: <%= tasksList[i].date %></p>
                            </div>

                            <%# Action Interactive Control Interface (Delete and Edit processing structures) %>
                            <div class="mt-3 pt-2 border-top d-flex gap-2">
                                
                                <%# Form processing system targeting deletion routing configurations %>
                                <form action="/delete-item" method="POST" class="m-0 flex-grow-1">
                                    <%# Critical hidden index configuration field pointing directly to the current array item loop tracker %>
                                    <input type="hidden" name="itemIndex" value="<%= i %>">
                                    <button type="submit">Delete</button>
                                </form>

                                <%# Form processing layout configuration managing update redirection schemes %>
                                <form action="/edit-item" method="POST" class="m-0 flex-grow-1">
                                    <input type="hidden" name="itemIndex" value="<%= i %>">
                                    <button type="submit">Edit</button>
                                </form>

                            </div>
                        </div>
                    </div>

                </div>
            <% } %> <%# Close master processing loop %>

        </div>
    </div>
    <br>
    <br>    
    
</body>
</html>