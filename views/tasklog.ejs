<html>
<head>
    <meta charset="UTF-8">    <%# code below is to set up the head section of the HTML document, including meta tags for character encoding and viewport settings, as well as links to Bootstrap CSS and JS files for styling and responsiveness. %>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>The Trusty Task Reminder</title>
</head>
<body style="background-image: url('/IMG_0136-1280x920.jpeg');">
    <%- include ('partials/navbar') %>    <%#To include the navigation bar in the home page %>
    <h2><span style="color: indigo;">Welcome Back to your very own TASK REMINDER, whose here to not let your forgetfulness forget</span></h2>
    <br>
    <h5><span style="color: navy;">I am ready to not make you forget</span></h5>
    
    <hr class="my-4">
    <h3 class="mb-3 text-dark fw-bold">Task Board:</h3>
        
        <tr>
            <th><span style="color: magenta;">Favourite Hobbies You Did</span></th>       <%#Create the table headers for each category of activities. %>
            <th><span style="color: magenta;">Great Sports You Played</span></th>          
            <th><span style="color: magenta;">Awesome Videogames You Played</span></th>
            <th><span style="color: magenta;">Amazing Movies You've Watched</span></th>
        </tr>
        <tr>
            <td>
                <ol>
                    <% for(let i = 0; i < hobbiesList.length ; i++) { %>      <%# Loop through the List array and display each activity in an ordered list. %>
                        <li>
                            <%= hobbiesList[i].name %> (<%= hobbiesList[i].rating %>)   <%# Displays the name and rating of each activity in the array, using the properties of the activityObject created in the POST route. %>
                            <form action="/delete-item" method="POST">                   <%# [i] is to serve as an array index pointer to identify the index of the activity to be deleted in the array. %>
                                <input type="hidden" name="category" value="Hobbies">    <%# name= feature here is important to identify the category of the activity to be deleted. Values are also important here to help the server know which category to target %>
                                <input type="hidden" name="itemIndex" value="<%= i %>">    <%# name feature here is important to identify the index of the activity to be deleted in the array, and value is to help the server know which activity to target %>
                                <button type="submit">Delete</button>
                            </form>
                            <form action="/edit-item" method="POST">                   <%# Create a form to submit the category and index of the activity to be edited to the server and to update the activity list. %>
                                <input type="hidden" name="category" value="Hobbies">   <%# Same rules of the delete function name and value features apply here to help the server know which category to target for edit %>
                                <input type="hidden" name="itemIndex" value="<%= i %>">
                                <button type="submit">Edit</button>
                            </form>
                        </li>
                    <% } %>
                </ol>
            </td>
            <td>
                <ol>
                    <% for(let i = 0; i < sportsList.length ; i++) { %>
                        <li>
                            <%= sportsList[i].name %> (<%= sportsList[i].rating %>)   <%# () are to blend logic tags with HTML elements to display the name and rating of each activity in the array %>
                            <form action="/delete-item" method="POST">
                                <input type="hidden" name="category" value="Sports">
                                <input type="hidden" name="itemIndex" value="<%= i %>">
                                <button type="submit">Delete</button>
                            </form>
                            <form action="/edit-item" method="POST" >
                                <input type="hidden" name="category" value="Sports"> 
                                <input type="hidden" name="itemIndex" value="<%= i %>">
                                <button type="submit">Edit</button>
                            </form>
                        </li>
                    <% } %>
                </ol>
            </td>
            <td>
                <ol>
                    <% for(let i = 0; i < videogamesList.length ; i++) { %>
                        <li>
                            <%= videogamesList[i].name %> (<%= videogamesList[i].rating %>)   
                            <form action="/delete-item" method="POST">
                                <input type="hidden" name="category" value="Videogames">
                                <input type="hidden" name="itemIndex" value="<%= i %>">
                                <button type="submit">Delete</button>
                            </form>
                            <form action="/edit-item" method="POST">
                                <input type="hidden" name="category" value="Videogames"> 
                                <input type="hidden" name="itemIndex" value="<%= i %>">
                                <button type="submit">Edit</button>
                            </form>
                        </li>
                    <% } %>
                </ol>
            </td>
            <td>
                <ol>
                    <% for(let i = 0; i < moviesList.length ; i++) { %>
                        <li>
                            <%= moviesList[i].name %> (<%= moviesList[i].rating %>)   
                            <form action="/delete-item" method="POST">
                                <input type="hidden" name="category" value="Movies">
                                <input type="hidden" name="itemIndex" value="<%= i %>">
                                <button type="submit">Delete</button>
                            </form>
                            <form action="/edit-item" method="POST">
                                <input type="hidden" name="category" value="Movies"> 
                                <input type="hidden" name="itemIndex" value="<%= i %>">
                                <button type="submit">Edit</button>
                            </form>
                        </li>
                    <% } %>
                </ol>
            </td>
        </tr>
    <br>
    <br>
    
</body>
</html>