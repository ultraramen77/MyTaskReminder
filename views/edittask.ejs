<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Edit and Update a Task</title>
</head>
<body style="background-image: url('/IMG_0136-1280x920.jpeg');">
    <%- include ('partials/navbar') %>         <%# To include the navigation bar in the edit activity page %>
    <div class="container mt-3">               <%# Create a container to hold the form for editing an activity. %>
        <h1><span style="color: aqua;">Edit Existing Task Details</span></h1>
        <form action="/update-item" method="POST">                       <%# Create a form to submit the updated activity details to the server and to update the activity list. %>
            <input type="hidden" name="priority" value="<%= priority %>">    <%# name and value features here are important to identify the category of the activity to be updated and to help the server know which category to target (needed or will display error message) %>
            <input type="hidden" name="itemIndex" value="<%= index %>">  <%# name and value features here are important to identify the index of the activity to be updated in the array and to help the server know which activity to target for update (Needed or else activty won't update)%>

            <div class="mb-3 mt-3">
                <label for="itemName"><span style="color: midnightblue;">Type out the new name of the task:</span></label>
                <input type="text" class="form-control" id="itemName" placeholder="Enter new task name" name="itemName" required>   <%# class is used to apply Bootstrap styling to the input field %>
            </div>

            <div class="mb-3 mt-3">
                <label for="itemRating"><span style="color: midnightblue;">Select the new priority:</span></label>
                <select id="itemRating" name="itemRating">
                    <option value="Low">Low</option>
                    <option value="Medium">Medium</option>
                    <option value="High">High</option>
                    <option value="IMPORTANT!">IMPORTANT!</option>
                </select>
                <br>
                <br>
                <span style="color: midnightblue;">Select the date to finish the task:</span>
                <br>
                <input type="date" name="taskdate" id="taskdate" required>
                <br>
            </div>

            <button type="submit"><span style="color:limegreen;">Update Task Details</span></button>
        </form>
    </div>  
</body>
</html>
