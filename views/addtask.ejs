<html>
<head>
    <meta charset="UTF-8">   
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <title>Add A Task For Reminder</title>
</head>
<body style="background-image: url('/IMG_0136-1280x920.jpeg');">
    <%- include ('partials/navbar') %>    <%#To include the navigation bar in the home page %>
    <h1><span style="color: turquoise;">Add A Task For Reminder</span></h1>
    <form action="/add-item" method="POST">               <%# Create a form to submit the new activity details to the server and to update the activity list. %>
        <span style="color: midnightblue;">Type out your task: </span><input type="text" name="itemName" placeholder="Enter task name" required>
    <br>
    <br>
        <span style="color: midnightblue;">Select Priority:</span>
        <select name="priority" id="priority">        <%# Create a dropdown menu for users to select the priority of the new task to be added. %>
            <option value="Low">Low</option>     <%# Option values are to help identify the priority of the new task to be added, and then used in the POST route to add the new task to the correct array/List %>
            <option value="Medium">Medium</option>
            <option value="High">High</option>
            <option value="IMPORTANT!">IMPORTANT!</option>
        </select>
        <br>
        <br>
        <span style="color: midnightblue;">Select the date to finish the task:</span>
        <br>
        <input type="date" name="taskdate" id="taskdate" required>
        <br>
        <br>
        <button type="submit"><span style="color: limegreen;">Add The Task</span></button>
    </form>
</body>
</html>